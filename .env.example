APP_NAME="Cekat.biz.id"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Brevo SMTP relay (https://smtp-relay.brevo.com:587, STARTTLS)
# Username = SMTP login (Settings > SMTP & API > SMTP tab), Password = SMTP key
# (NOT the API key - API keys start with xkeysib-, SMTP keys with xsmtpsib-)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender must be verified in Brevo (Settings > Senders & IP)
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
# System notifications (new signups, admin settings changes); empty = first admin account
ADMIN_NOTIFY_EMAIL=

# AI Provider (OpenRouter)
# Get a key at https://openrouter.ai/keys - REQUIRED, no default is bundled.
OPENROUTER_API_KEY=
# openrouter/free = Free Models Router (auto-picks an available free model)
OPENROUTER_DEFAULT_MODEL=openrouter/free
# Used when the default model fails (retired id, 429, 5xx, empty content)
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Midtrans Payments
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# WhatsApp (Fonnte) - account token disimpan via SettingsSeeder (key: fonnte_account_token)
FONNTE_ACCOUNT_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
